# Copy to .env on the SmartBIS host, then replace every example value.
# Never commit .env or share the generated secrets.

SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=changeme

ADMIN_EMAIL=mdm-admin@example.org
# Development uses this PC's current LAN IP; replace it with the production server IP when porting.
# The IP must be present as an IP SAN in the MDM TLS certificate.
MDM_HOST=192.168.100.50
SMARTBIS_NETWORK=smartbis_jangsung_default

# Optional but recommended when Headwind server is behind NAT: host LAN/private IP.
SERVER_LAN_IP=

# Generate a unique random value (for example: openssl rand -hex 32).
SHARED_SECRET=changeme

# Keep the WAR and mobile-agent versions aligned to a verified Headwind release.
HMDM_URL=https://h-mdm.com/files/hmdm-5.40.1-os.war
CLIENT_VERSION=6.37
HMDM_ENROLLMENT_CONFIG_KEY=
