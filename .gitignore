# 환경 변수 및 설정 파일
.env
.gstack/

# Headwind MDM 운영 비밀값과 영속 데이터
/deployment/headwind-mdm/.env
/deployment/headwind-mdm/volumes/
/deployment/headwind-mdm/backups/
/deployment/headwind-mdm/certs/*
!/deployment/headwind-mdm/certs/README.md
/deployment/headwind-mdm/releases/
/client-android/releases/

# 보안 및 인증서 (SSL/TLS)
server/nginx/certs/*.key
server/nginx/certs/*.csr
server/nginx/certs/*.srl
server/nginx/certs/rootCA.*
server/nginx/certs/server.*

# 빌드 및 의존성 라이브러리 폴더
target/
node_modules/
.gradle/
.gradle-user/

# IDE (개발 툴) 설정 파일
.idea/
.vscode/

# 업로드 저장소 (비어있는 폴더 유지를 위한 .gitkeep 제외)
upload-store/*
!upload-store/.gitkeep

# 운영 미디어 저장소는 별도 백업·이관 대상이며 Git에 포함하지 않음
/content-store/
/server/content-store/**
!/server/content-store/.gitkeep

# [추가] GitHub 용량 제한(100MB) 초과 방지를 위한 대용량 폴더 예외 처리
장성군 클라우드 홈페이지 시스템/

# ��� ���� �� env ���
.env.backup-*
.env.bak*

# ���塤���⹰
*.apk
*.aab
*.war
*.jar
*.bak*
target/
volumes/
certs/
releases/
reports/
.tmp/
.kotlin/
.gstack/
*.pyc
__pycache__/
